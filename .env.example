# Copy this file to .env and fill in your values.

# ── Agent URLs ────────────────────────────────────────────────────────────────
SEO_MONITOR_AGENT_URL=http://localhost:8001
CONTENT_OPTIMIZER_AGENT_URL=http://localhost:8002

# Future agents (uncomment when ready)
# CONTENT_WRITER_AGENT_URL=http://localhost:8003
# KEYWORD_RESEARCH_AGENT_URL=http://localhost:8004
# TECHNICAL_SEO_AGENT_URL=http://localhost:8005

# ── App settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development      # development | production
LOG_LEVEL=INFO
PDF_DIR=static/pdfs
